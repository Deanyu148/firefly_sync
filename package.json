{
  "name": "firefly-sync",
  "version": "0.1.4",
  "description": "Sync Obsidian Markdown posts to a FireFly Astro blog through Git.",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --external:obsidian --outfile=main.js --format=cjs --platform=node --target=es2020",
    "dev": "esbuild src/main.ts --bundle --external:obsidian --outfile=main.js --format=cjs --platform=node --sourcemap --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "firefly",
    "git",
    "astro"
  ],
  "author": "Deanyu148",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deanyu148/firefly_sync.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
